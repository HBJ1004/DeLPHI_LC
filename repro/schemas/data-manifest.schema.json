{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delphi-project.example/schemas/v2/data-manifest.schema.json",
  "title": "DeLPHI V2 data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "manifest_id", "dataset", "source", "label_policy", "splits", "files", "builder"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_type": {"const": "data"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "created_at_utc"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "snapshot_id", "canonical_uri", "retrieved_at_utc", "license", "citation", "sha256"],
      "properties": {
        "name": {"const": "DAMIT"},
        "snapshot_id": {"const": "damit-20250610T000301Z"},
        "canonical_uri": {"type": "string", "format": "uri"},
        "retrieved_at_utc": {"type": "string", "format": "date-time"},
        "license": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "label_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_quality_flag", "coordinate_frame", "directed_poles", "antipodal_equivalence"],
      "properties": {
        "minimum_quality_flag": {"type": "integer", "minimum": 3},
        "coordinate_frame": {"const": "ecliptic_j2000"},
        "directed_poles": {"const": true},
        "antipodal_equivalence": {"const": false}
      }
    },
    "splits": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "n_objects", "object_ids_sha256"],
        "properties": {
          "name": {"enum": ["train", "validation", "test", "prospective_test"]},
          "n_objects": {"type": "integer", "minimum": 1},
          "object_ids_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_repository", "git_commit", "git_dirty", "command"],
      "properties": {
        "git_repository": {"type": "string", "format": "uri"},
        "git_commit": {"$ref": "#/$defs/git_commit"},
        "git_dirty": {"const": false},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "logical_path", "sha256", "size_bytes", "media_type", "role"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "logical_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["source", "labels", "features", "split", "metadata"]}
      }
    }
  }
}
