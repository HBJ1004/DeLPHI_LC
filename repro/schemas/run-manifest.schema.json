{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delphi-project.example/schemas/v2/run-manifest.schema.json",
  "title": "DeLPHI V2 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "run_id", "created_at_utc", "release_spec_sha256", "git", "environment", "randomness", "data_manifests", "command", "inputs", "outputs"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_type": {"const": "run"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "release_spec_sha256": {"$ref": "#/$defs/sha256"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit": {"$ref": "#/$defs/git_commit"},
        "dirty": {"const": false}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform", "dependency_lock_sha256"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "cuda": {"type": ["string", "null"]},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_seed", "deterministic_algorithms"],
      "properties": {
        "training_seed": {"enum": [17, 42, 137, 777, 2027]},
        "deterministic_algorithms": {"const": true}
      }
    },
    "data_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/manifest_ref"}
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "sha256"],
      "properties": {
        "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "logical_path", "sha256", "size_bytes", "media_type", "role"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "logical_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["input", "checkpoint", "predictions", "metrics", "log", "environment", "other"]}
      }
    }
  }
}
