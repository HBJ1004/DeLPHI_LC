{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delphi-project.example/schemas/v2/artifact-manifest.schema.json",
  "title": "DeLPHI V2 immutable artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_type", "record_id", "created_at_utc", "archive", "license", "creators", "related_identifiers", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_type": {"const": "artifact"},
    "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "doi", "record_url", "published_at_utc", "immutable"],
      "properties": {
        "provider": {"const": "zenodo"},
        "doi": {"type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$"},
        "record_url": {"type": "string", "format": "uri"},
        "published_at_utc": {"type": "string", "format": "date-time"},
        "immutable": {"const": true}
      }
    },
    "license": {"type": "string", "minLength": 1},
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "orcid": {"type": "string", "pattern": "^https://orcid\\.org/[0-9X-]{19}$"}
        }
      }
    },
    "related_identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "relation"],
        "properties": {
          "identifier": {"type": "string", "format": "uri"},
          "relation": {"enum": ["isSupplementTo", "isVersionOf", "isDerivedFrom", "isIdenticalTo"]}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "logical_path", "sha256", "size_bytes", "media_type", "role", "generated_by_run_id"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "logical_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "role": {"enum": ["dataset", "checkpoint", "predictions", "metrics", "environment", "documentation"]},
        "generated_by_run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
      }
    }
  }
}
